{
  "name": "qa-checklist",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests *.json *.ts *.js index.html README.md docs",
    "format:check": "prettier --check src tests *.json *.ts *.js index.html README.md docs",
    "test": "vitest run"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "pinia": "^3.0.4",
    "vue": "^3.5.44",
    "vue-router": "^4.6.3",
    "vuetify": "^3.13.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.1.0"
  }
}
